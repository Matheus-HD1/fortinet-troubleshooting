#GERÊNCIA VIA VPN_IPSEC

config system interface
edit "Loopback_GRC"
set vdom "root"
set ip <LOOPBACK 100 GERADA PELA GRC> 255.255.255.255
set allowaccess ping https ssh http telnet snmp probe-response
set type loopback
set description "Loopback_GRC"
set alias "Loopback_Gerencia"
next
end
 
 
config vpn ipsec phase1-interface 
edit "TO-GRC" 
set interface "wan" 
set ike-version 2 
set peertype any 
set net-device disable 
set proposal aes256-sha256 aes256-sha1 aes128-sha256 
set localid <HOSTNAME>
set dpd on-idle
set remote-gw 189.3.56.154(GOV) 189.3.255.221(PORT) - ATENTAR-SE PARA O DESTINATIO, SE É GOV OU PORT
