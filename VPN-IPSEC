config vpn ipsec phase2-interface 
edit "TO-GRC" 
set phase1name "TO-GRC" 
set proposal aes256-sha256 aes256-sha1 aes128-sha256 
set src-subnet <LOOPBACK 100 GERADA PELA GRC> 255.255.255.255
set dst-subnet 169.248.255.254 255.255.255.255 
next 
end
 
config firewall address 
edit "GER-GRC" 
set subnet 169.248.255.254 255.255.255.255 
next 
edit "Loopback-GRC" 
set subnet <LOOPBACK 100 GERADA PELA GRC> 255.255.252.0
next 
end
 
config router static 
edit 0
set dst 169.248.255.254 255.255.255.255 
set device "TO-GRC" 
set comment "Gerencia GRC" 
next 
edit 0 
set dst 189.3.56.154 255.255.255.255 
set device "wan" 
set comment "Gerencia GRC" 
set dynamic-gateway enable 
next 
end
 
config firewall policy
edit 0
set name "GRC-IN"
set srcintf "TO-GRC"
set dstintf "Loopback_GRC"
set action accept
set srcaddr "GER-GRC"
set dstaddr "Loopback-GRC"
set schedule "always"
set service "ALL"
set comments GRC-IN
next
edit 0
set name "GRC-OUT"
set srcintf "Loopback_GRC"
set dstintf "TO-GRC"
set action accept
set srcaddr "Loopback-GRC"
set dstaddr "GER-GRC"
set schedule "always"
set service "ALL"
set comments GRC-OUT
next
end
